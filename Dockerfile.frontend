# Frontend (Didi AI Tool — Next.js standalone) for GreenNode AgentBase
# Build:  docker build -f Dockerfile.frontend -t didi-ui .
#
# Native deps in this app: better-sqlite3 + canvas (node-canvas) + @napi-rs/canvas.
# Builder carries the toolchain so npm ci can compile if a prebuilt binary is missing;
# runner carries the cairo/pango runtime libs that node-canvas links against.

# ---------- builder ----------
FROM node:22-bookworm AS builder
WORKDIR /app
# Toolchain for node-gyp (better-sqlite3) + headers for node-canvas
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---------- runner ----------
FROM node:22-bookworm-slim AS runner
WORKDIR /app
# Runtime shared libs for node-canvas (better-sqlite3 binary is self-contained)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    STATE_DIR=/data \
    NEXT_TELEMETRY_DISABLED=1
RUN mkdir -p /data
# Next standalone bundles only the traced node_modules + server.js at the tracing root
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 8080
CMD ["node", "server.js"]
