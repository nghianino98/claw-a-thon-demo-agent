# Agent personality
AGENT_NAME=Mây
AGENT_API_KEY=
AGENT_MEMORY_DB=.agent_memory.sqlite3
MAX_HISTORY_MESSAGES=18
KNOWLEDGE_INDEX_PATH=.knowledge_base.sqlite3
KNOWLEDGE_MAX_CHUNKS=5
KNOWLEDGE_MAX_CONTEXT_CHARS=6000

# Optional OpenAI-compatible LLM provider.
# Without these, the agent still runs in local fallback mode for testing.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional Telegram bot integration.
# TELEGRAM_BOT_TOKEN is the full token from BotFather.
# TELEGRAM_WEBHOOK_SECRET can be any random path-safe string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated Telegram numeric user IDs.
# Empty means anyone can chat with the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Numeric Telegram user IDs that receive and approve access requests.
TELEGRAM_OWNER_USER_IDS=
