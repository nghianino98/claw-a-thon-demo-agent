# ─────────────────────────────────────────────────────────────
# General App Configuration
# ─────────────────────────────────────────────────────────────
APP_ENV=development
AGENT_NAME=Quéo
STATE_DIR=/data
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Authentication & Role-Based Access Control (RBAC)
# ─────────────────────────────────────────────────────────────
# Leave AUTH_MODE=off for local single-user (default).
# Set AUTH_MODE=required to enable login / RBAC / audit.
AUTH_MODE=off

# Required when AUTH_MODE=required (min 32 chars)
DIDI_APP_SECRET=

# First-boot superadmin (used only until the first account exists; password min 12 chars)
DIDI_BOOTSTRAP_USER=admin
DIDI_BOOTSTRAP_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Crawler Configuration (Confluence, Jira, GitLab)
# ─────────────────────────────────────────────────────────────
# Confluence Auth
CONFLUENCE_API_KEY=
CONFLUENCE_USERNAME=

# Jira Auth
JIRA_API_KEY=
JIRA_USERNAME=

# GitLab Auth
GITLAB_PRIVATE_TOKEN=

# ─────────────────────────────────────────────────────────────
# Agent API & Connection Configuration (BFF Proxy)
# ─────────────────────────────────────────────────────────────
# Direct API auth. Required in production.
AGENT_API_KEY=

# Service token for Didi BFF -> agent admin API. Required in production.
AGENT_ADMIN_TOKEN=

# Connection details for the Next.js Tool to reach the FastAPI Agent
AGENT_CONNECTION_ID=queo-solution-agent
AGENT_CONNECTION_NAME=Quéo Solution Agent
AGENT_BASE_URL=http://localhost:8080
AGENT_PROXY_TIMEOUT_MS=30000
AGENT_PROXY_UPLOAD_TIMEOUT_MS=120000

# Knowledge-base push (KB delta sync). Enables POST /api/knowledge-base/push-to-agent.
# Must be >= 32 chars. Leave empty to keep the feature disabled (endpoint returns 503).
AGENT_SYNC_API_KEY=

# ─────────────────────────────────────────────────────────────
# LLM & MaaS Configuration
# ─────────────────────────────────────────────────────────────
# GreenNode MaaS / OpenAI-compatible endpoint.
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_LITE=
LLM_TIMEOUT_SECONDS=60
TOOLCALL_MODE=native

# ─────────────────────────────────────────────────────────────
# Agent Limits & Budgets
# ─────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_DEEP_MAX_STEPS=24
AGENT_DEEP_TIMEOUT_SECONDS=420
AGENT_MAX_PARALLEL_TOOLS=4
AGENT_TOTAL_TIMEOUT_SECONDS=130
AGENT_MAX_CONCURRENT=4
CONTEXT_BUDGET_CHARS=48000
CONTEXT_BUDGET_CHARS_MAX=400000
TOOL_RESULT_MAX_CHARS=8000
KB_READ_MAX_CHARS=12000
MAX_HISTORY_MESSAGES=18
PROGRESS_FIRST_SECONDS=8
PROGRESS_UPDATE_SECONDS=25

# ─────────────────────────────────────────────────────────────
# Model Context Protocol (MCP)
# ─────────────────────────────────────────────────────────────
MCP_ENABLED=1
MCP_SECRET_KEY=
MCP_CALL_TIMEOUT_SECONDS=60
JIRA_MCP_SECRET=

# ─────────────────────────────────────────────────────────────
# Telegram Integration
# ─────────────────────────────────────────────────────────────
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# ─────────────────────────────────────────────────────────────
# Rate Limits
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=200

# ─────────────────────────────────────────────────────────────
# Workflows & Scheduling
# ─────────────────────────────────────────────────────────────
WORKFLOW_MAX_CONCURRENT=2
WORKFLOW_MAX_STEPS=15
WORKFLOW_TOTAL_TIMEOUT_SECONDS=1800

# ─────────────────────────────────────────────────────────────
# Knowledge Base & Sync
# ─────────────────────────────────────────────────────────────
KB_UPLOAD_MAX_MB=2000
KB_FILE_MAX_MB=20
KB_KEEP_VERSIONS=3
KB_DELTA_MAX_MB=100
SYNC_API_KEY=
KB_SOURCE_DIR=
KB_SYNC_ACTIVATE=auto
# Image-baked KB archive auto-seeded on cold boot when /data is empty (no S3 needed).
KB_SEED_ZIP=seed/kb-seed.zip

# ─────────────────────────────────────────────────────────────
# Backup & S3 Storage
# ─────────────────────────────────────────────────────────────
ARTIFACT_RETENTION_DAYS=14
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_INCLUDE_ARTIFACTS=0

# ─────────────────────────────────────────────────────────────
# Guardrail & Safety
# ─────────────────────────────────────────────────────────────
GUARDRAIL_CONFIG=config/guardrail.yaml
